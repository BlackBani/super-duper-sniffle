---
import BaseLayout from '@layouts/BaseLayout.astro';
import StrengthFinder from '@components/home/StrengthFinder.astro';

const lang = 'ru';
---

<BaseLayout 
  title="Подбор крепости паучей в Молдове | Легкие-Hardcore | Pauch"
  description="Ответьте на несколько вопросов и получите рекомендацию по крепости: Легкие, Средние, Крепкие или Hardcore. Гид для взрослых в Молдове. 18+."
>
  <h1 class="sr-only">Подберите крепость никотиновых паучей</h1>
  <div class="py-8 md:py-12">
    <StrengthFinder lang={lang} />
  </div>
</BaseLayout>
