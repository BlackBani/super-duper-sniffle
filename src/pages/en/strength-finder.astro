---
import BaseLayout from '@layouts/BaseLayout.astro';
import StrengthFinder from '@components/home/StrengthFinder.astro';

const lang = 'en';
---

<BaseLayout 
  title="Nicotine Pouch Strength Finder in Moldova | Easy to Hardcore | Pauch"
  description="Answer a few questions and get your nicotine pouch strength recommendation: Easy, Medium, Strong, or Hardcore. Adult-use guidance for Moldova. 18+."
>
  <h1 class="sr-only">Find Your Nicotine Pouch Strength</h1>
  <div class="py-8 md:py-12">
    <StrengthFinder lang={lang} />
  </div>
</BaseLayout>
