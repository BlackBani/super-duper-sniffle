---
import BaseLayout from '@layouts/BaseLayout.astro';
import StrengthFinder from '@components/home/StrengthFinder.astro';

const lang = 'ro';
---

<BaseLayout 
  title="Test tărie pliculețe cu nicotină în Moldova | Ușoară-Hardcore | Pauch"
  description="Răspunde la câteva întrebări și află tăria potrivită: Ușoară, Medie, Puternică sau Hardcore. Ghid pentru adulți din Moldova. 18+."
>
  <h1 class="sr-only">Găsește tăria potrivită la pliculețe cu nicotină</h1>
  <div class="py-8 md:py-12">
    <StrengthFinder lang={lang} />
  </div>
</BaseLayout>
