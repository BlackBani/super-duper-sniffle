---
import '../styles/global.css';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import AgeGate from '@components/layout/AgeGate.astro';
import TelegramButton from '@components/ui/TelegramButton.astro';
import { getLangFromUrl, useTranslations, getAlternateUrls, type Language } from '@i18n/index';
import { absoluteUrl, site } from '../config/site';
import { buildInfo } from '../config/build';
import { serializeJsonLd } from '../lib/seo/jsonld';
import { getPublicImageMetadata } from '../lib/images/metadata';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  schema?: object;
  ogType?: 'website' | 'article' | 'product';
  alternates?: Array<{ lang: Language; url: string }>;
}

const { title, description, image, canonicalPath, schema, ogType = 'website', alternates: customAlternates } = Astro.props;

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

const pageTitle = title || t.site.title;
const pageDescription = description || t.site.description;

const base = import.meta.env.BASE_URL || '/';
const baseClean = base.endsWith('/') ? base.slice(0, -1) : base;
const pageImage = image || site.defaultOgPath;
const pageImageMetadata = getPublicImageMetadata(pageImage);

const currentPath = Astro.url.pathname;
const alternates = customAlternates || getAlternateUrls(currentPath);

// x-default should point to the same page in the fallback locale, not to homepage.
const xDefaultLocale: Language = 'ro';
const xDefaultPath = /^\/(en|ro|ru)\/$/.test(currentPath) ? '/' :
  alternates.find(({ lang: altLang }) => altLang === xDefaultLocale)?.url ||
  alternates[0]?.url ||
  '/ro/';

// Site URL without trailing slash
const siteOrigin = Astro.site?.origin || site.origin;
const siteUrl = `${siteOrigin}${baseClean}`;

// Build canonical URL - remove base from currentPath if it starts with base
let pathForCanonical = currentPath;
if (baseClean && pathForCanonical.startsWith(baseClean)) {
  pathForCanonical = pathForCanonical.slice(baseClean.length);
}
const canonicalUrl = canonicalPath 
  ? `${siteUrl}${canonicalPath}`
  : `${siteUrl}${pathForCanonical}`;

// Default organization schema
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": site.organizationId,
  "name": site.name,
  "url": site.origin,
  "logo": absoluteUrl(site.logoPath)
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": site.websiteId,
  "name": site.name,
  "url": site.origin,
  "publisher": { "@id": site.organizationId },
  "inLanguage": lang
};

const combinedSchema = schema 
  ? [organizationSchema, websiteSchema, ...(Array.isArray(schema) ? schema : [schema])]
  : [organizationSchema, websiteSchema];
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="pauch-build" content={buildInfo.commit} />
    
    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    
    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Hreflang -->
    {alternates.map(({ lang: altLang, url }) => (
      <link rel="alternate" hreflang={altLang} href={`${siteUrl}${url}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${xDefaultPath}`} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${baseClean}/favicon.svg`} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={`${siteUrl}${pageImage}`} />
    <meta property="og:image:width" content={String(pageImageMetadata.width)} />
    <meta property="og:image:height" content={String(pageImageMetadata.height)} />
    <meta property="og:image:type" content={pageImageMetadata.type} />
    <meta property="og:image:alt" content={`${pageTitle} — Pauch`} />
    <meta property="og:locale" content={lang} />
    {alternates.filter(a => a.lang !== lang).map(({ lang: altLang }) => (
      <meta property="og:locale:alternate" content={altLang} />
    ))}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}${pageImage}`} />
    <meta name="twitter:image:alt" content={`${pageTitle} — Pauch`} />
    
    <!-- Preconnect for fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Schema.org JSON-LD -->
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(combinedSchema)} />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <AgeGate lang={lang} />
    <Header lang={lang} alternates={alternates} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <TelegramButton lang={lang} />
  </body>
</html>
