---
import { useTranslations, type Language } from '@i18n/index';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="orders-paused"
  class="bg-amber-50 border-b border-amber-200"
  aria-label={t.pause.ariaLabel}
>
  <div class="container py-3 md:py-4">
    <div class="flex items-start justify-center gap-3 text-left md:text-center">
      <span class="mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-amber-100 text-amber-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M4.93 19h14.14c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.2 16c-.77 1.33.19 3 1.73 3z" />
        </svg>
      </span>
      <div>
        <p class="text-sm md:text-base font-semibold text-primary">{t.pause.title}</p>
        <p class="text-xs md:text-sm text-muted leading-relaxed">{t.pause.message}</p>
      </div>
    </div>
  </div>
</section>
