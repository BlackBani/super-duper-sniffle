---
import { getCollection } from 'astro:content';
import { getLocalizedPath, type Language } from '@i18n/index';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const brands = (await getCollection('brands'))
  .map(({ data }) => data)
  .filter((brand) => brand.status !== 'discontinued' && brand.representedProductSlugs.length > 0)
  .sort((a, b) => a.displayName.localeCompare(b.displayName));
---

<section class="py-2 md:py-3 bg-white border-b border-border overflow-hidden">
  <!-- Scrolling brands marquee -->
  <div class="brands-marquee">
    <div class="brands-track">
      {[...brands, ...brands, ...brands].map((brand, index) => (
        <a class="brand-item" href={getLocalizedPath(`/brands/${brand.slug}/`, lang)} aria-hidden={index >= brands.length ? 'true' : undefined} tabindex={index >= brands.length ? '-1' : undefined}>
          <span class="brand-text">{brand.displayName}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .brands-marquee {
    width: 100%;
    overflow: hidden;
  }
  
  .brands-track {
    display: flex;
    gap: 1.75rem;
    animation: scroll-brands 30s linear infinite;
    width: max-content;
  }
  
  .brand-item {
    flex-shrink: 0;
    opacity: 0.85;
    transition: opacity 0.3s;
    text-decoration: none;
  }
  
  .brand-item:hover {
    opacity: 1;
  }
  
  .brand-text {
    font-size: 1rem;
    font-weight: 800;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #1f2937;
  }
  
  @media (min-width: 768px) {
    .brands-track {
      gap: 3.5rem;
    }
    
    .brand-text {
      font-size: 1.25rem;
    }
  }
  
  @keyframes scroll-brands {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.333%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brands-track { animation: none; }
  }
</style>
