---
import { useTranslations, getLocalizedPath, getTelegramOrderLink, type Language } from '@i18n/index';
import { getPublicImageMetadata } from '../../lib/images/metadata';
import { getResponsiveImageData } from '../../lib/images/responsive';

interface FlavorVariant {
  slug: string;
  flavorCategory: string;
  flavorName: string;
  image: string;
}

interface ProductLine {
  id: string;
  brand: string;
  strength: number;
  strengthCategory: string;
  pouchesPerCan: number;
  image: string;
  flavors: FlavorVariant[];
}

interface Props {
  lang: Language;
  productLine: ProductLine;
}

const { lang, productLine } = Astro.props;
const t = useTranslations(lang);

const base = import.meta.env.BASE_URL || '/';
const baseClean = base.endsWith('/') ? base.slice(0, -1) : base;

const withBase = (src: string) => (src.startsWith('/') ? `${baseClean}${src}` : src);

const strengthLabels: Record<string, string> = {
  easy: t.strengths.easy,
  medium: t.strengths.medium,
  strong: t.strengths.strong,
  hardcore: t.strengths.hardcore,
};

// Product line title without flavor
const title = `${productLine.brand} ${strengthLabels[productLine.strengthCategory]}`;

const defaultFlavor = productLine.flavors[0];
const defaultImagePath = defaultFlavor?.image || productLine.image;
const imageSrc = withBase(defaultImagePath);
const imageMetadata = getPublicImageMetadata(defaultImagePath);
const responsiveImage = getResponsiveImageData(defaultImagePath, [320, 480, 640]);
const imageContext = {
  en: 'nicotine pouch can, product packaging',
  ro: 'cutie de pliculețe cu nicotină, ambalajul produsului',
  ru: 'банка никотиновых паучей, упаковка товара',
}[lang];
const imageAlt = `${title} — ${imageContext}`;
const placeholderSrc = `${baseClean}/images/products/placeholder.svg`;
const defaultProductHref = getLocalizedPath(`/product/${defaultFlavor?.slug || ''}`, lang);

const flavors = productLine.flavors.map((flavor) => {
  const metadata = getPublicImageMetadata(flavor.image);
  const responsive = getResponsiveImageData(flavor.image, [320, 480, 640]);
  return {
    ...flavor,
    src: withBase(flavor.image),
    srcset: responsive.srcset,
    width: metadata.width,
    height: metadata.height,
    href: getLocalizedPath(`/product/${flavor.slug}`, lang),
    alt: `${productLine.brand} ${flavor.flavorName} ${strengthLabels[productLine.strengthCategory]} — ${imageContext}`,
  };
});

const telegramOrderLink = getTelegramOrderLink(lang);
---

<article
  class="product-line-card group flex flex-col bg-surface rounded-xl p-3 md:p-4 hover:shadow-product transition-shadow overflow-hidden"
  data-strength={productLine.strengthCategory}
  data-line-id={productLine.id}
  data-default-image={imageSrc}
  data-default-srcset={responsiveImage.srcset}
  data-default-width={imageMetadata.width}
  data-default-height={imageMetadata.height}
  data-default-alt={imageAlt}
  data-default-href={defaultProductHref}
>
  <!-- Product Image -->
  <div class="product-image-shell relative aspect-square mb-3 overflow-hidden rounded-lg md:rounded-xl">
    <a class="product-destination-link product-image-link block w-full h-full" href={defaultProductHref}>
      <img
        class="product-line-image w-full h-full object-contain p-3 md:p-4 transition-transform duration-300 group-hover:scale-105"
        src={imageSrc}
        alt={imageAlt}
        width={imageMetadata.width}
        height={imageMetadata.height}
        srcset={responsiveImage.srcset || undefined}
        sizes="(min-width: 1280px) 25vw, (min-width: 768px) 33vw, 72vw"
        loading="lazy"
        decoding="async"
        onerror={`this.removeAttribute('srcset');this.src='${placeholderSrc}'`}
      />
    </a>
    <!-- Strength Badge -->
    <span class="absolute top-2 right-2 px-2 py-0.5 md:px-2.5 md:py-1 bg-white text-[10px] md:text-xs font-semibold text-primary rounded-full shadow-md border border-gray-100">
      {strengthLabels[productLine.strengthCategory]}
    </span>
  </div>
  
  <!-- Product Info -->
  <div class="flex-1 flex flex-col min-w-0">
    <span class="text-[10px] md:text-xs text-muted mb-0.5">{productLine.brand}</span>
    <h3 class="text-xs md:text-sm font-semibold text-primary mb-2">
      <a class="product-destination-link hover:text-accent transition-colors" href={defaultProductHref}>{title}</a>
    </h3>
    
    <!-- Flavor Selection (optional) -->
    {productLine.flavors.length > 1 && (
      <div class="mb-3">
        <p class="text-[10px] md:text-xs text-muted mb-1.5">
          {lang === 'ru' ? 'Вкус (опц.):' : lang === 'ro' ? 'Aromă (opț.):' : 'Flavor (opt.):'}
        </p>
        <div class="flavor-chips flex flex-wrap gap-1">
          {flavors.map((flavor) => (
            <button
              type="button"
              class="flavor-chip px-2 py-0.5 md:px-2.5 md:py-1 text-[10px] md:text-xs rounded-full bg-white border border-gray-200 text-muted hover:border-accent hover:text-accent transition-all"
              data-flavor={flavor.flavorCategory}
              data-slug={flavor.slug}
              data-image={flavor.src}
              data-srcset={flavor.srcset}
              data-width={flavor.width}
              data-height={flavor.height}
              data-href={flavor.href}
              data-flavor-name={flavor.flavorName}
              data-alt={flavor.alt}
            >
              {flavor.flavorName}
            </button>
          ))}
        </div>
      </div>
    )}
    
    <!-- Actions -->
    <div class="mt-auto flex flex-col gap-1.5">
      <a
        href={telegramOrderLink}
        target="_blank"
        rel="noopener noreferrer"
        class="order-btn flex items-center justify-center gap-1.5 px-3 py-2 md:px-4 md:py-2.5 bg-accent text-white text-xs md:text-sm font-medium rounded-full hover:bg-opacity-90 transition-all"
      >
        <svg class="w-3.5 h-3.5 md:w-4 md:h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
        </svg>
        {t.catalog.orderButton}
      </a>
      <a
        href={defaultProductHref}
        class="product-destination-link details-btn text-center px-3 py-1.5 md:px-4 md:py-2 text-xs md:text-sm font-medium text-muted hover:text-primary transition-colors"
      >
        {t.catalog.detailsButton}
      </a>
    </div>
  </div>
</article>

<style>
  .product-image-shell {
    background:
      radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.95) 0%, rgba(246, 247, 249, 0.9) 45%, rgba(237, 239, 243, 0.85) 100%);
    border: 1px solid rgba(15, 23, 42, 0.08);
  }

  .flavor-chip.selected {
    @apply border-accent bg-accent/10 text-accent font-medium;
  }
</style>

<script>
  function initProductLineCards() {
    const cards = document.querySelectorAll('.product-line-card');
    
    cards.forEach((card) => {
      if (card.getAttribute('data-js-initialized') === 'true') return;
      card.setAttribute('data-js-initialized', 'true');

      const flavorChips = card.querySelectorAll('.flavor-chip');
      const destinationLinks = card.querySelectorAll('.product-destination-link');
      const productImage = card.querySelector('.product-line-image') as HTMLImageElement;
      const defaultImage = card.getAttribute('data-default-image') || '';
      const defaultSrcset = card.getAttribute('data-default-srcset') || '';
      const defaultWidth = card.getAttribute('data-default-width') || '';
      const defaultHeight = card.getAttribute('data-default-height') || '';
      const defaultAlt = card.getAttribute('data-default-alt') || '';
      const defaultHref = card.getAttribute('data-default-href') || '';

      const updateDestinations = (href: string) => {
        destinationLinks.forEach((link) => link.setAttribute('href', href));
      };

      const updateImage = (image: string, srcset: string, alt: string, width: string, height: string) => {
        if (!productImage || !image) return;
        productImage.src = image;
        if (srcset) productImage.srcset = srcset;
        else productImage.removeAttribute('srcset');
        productImage.alt = alt || defaultAlt;
        if (width) productImage.width = Number(width);
        if (height) productImage.height = Number(height);
      };
      
      flavorChips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const isCurrentlySelected = chip.classList.contains('selected');
          
          // Remove selection from all chips first
          flavorChips.forEach(c => c.classList.remove('selected'));
          
          if (isCurrentlySelected) {
            // Toggle off - deselect the chip
            updateDestinations(defaultHref);
            updateImage(defaultImage, defaultSrcset, defaultAlt, defaultWidth, defaultHeight);
          } else {
            // Select this chip
            chip.classList.add('selected');

            updateDestinations(chip.getAttribute('data-href') || defaultHref);
            updateImage(
              chip.getAttribute('data-image') || defaultImage,
              chip.getAttribute('data-srcset') || '',
              chip.getAttribute('data-alt') || defaultAlt,
              chip.getAttribute('data-width') || '',
              chip.getAttribute('data-height') || '',
            );
          }
        });
      });
    });
  }
  
  initProductLineCards();
  document.addEventListener('astro:page-load', initProductLineCards);
</script>
