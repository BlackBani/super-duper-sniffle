---
import Button from '@components/ui/Button.astro';
import { useTranslations, getLocalizedPath, getTelegramOrderLink, type Language } from '@i18n/index';
import { serializeJsonLd } from '../../lib/seo/jsonld';
import { getPublicImageMetadata } from '../../lib/images/metadata';
import { getResponsiveImageData } from '../../lib/images/responsive';
import { site } from '../../config/site';

interface Props {
  lang: Language;
  product: {
    slug: string;
    brand: string;
    strength: number;
    strengthCategory: string;
    flavorCategory: string;
    pouchesPerCan: number;
    image: string;
    translations: {
      [key: string]: {
        name: string;
        description: string;
      };
    };
  };
}

const { lang, product } = Astro.props;
const t = useTranslations(lang);
const translation = product.translations[lang];

const base = import.meta.env.BASE_URL || '/';
const baseClean = base.endsWith('/') ? base.slice(0, -1) : base;
const homePath = `${baseClean}/${lang}/`;
const catalogPath = `${homePath}#catalog`;

const siteOrigin = Astro.site?.origin || site.origin;
const siteUrl = `${siteOrigin}${baseClean}`;
const productAbsoluteUrl = `${siteUrl}/${lang}/product/${product.slug}/`;
const homeAbsoluteUrl = `${siteUrl}/${lang}/`;
const catalogAbsoluteUrl = `${siteUrl}/${lang}/`;

// Prepend base to image path
const imageSrc = product.image.startsWith('/') 
  ? `${baseClean}${product.image}` 
  : product.image;
const imageAbsoluteUrl = product.image.startsWith('/')
  ? `${siteUrl}${product.image}`
  : product.image;
const placeholderSrc = `${baseClean}/images/products/placeholder.svg`;
const imageMetadata = getPublicImageMetadata(product.image);
const responsiveImage = getResponsiveImageData(product.image, [480, 640, 800, 900]);

const strengthLabels: Record<string, string> = {
  easy: t.strengths.easy,
  medium: t.strengths.medium,
  strong: t.strengths.strong,
  hardcore: t.strengths.hardcore,
};
const strengthLabel = strengthLabels[product.strengthCategory] || product.strengthCategory;

const productHeading =
  lang === 'ro'
    ? `${product.brand} ${strengthLabel} pliculețe cu nicotină`
    : lang === 'ru'
      ? `${product.brand} ${strengthLabel} никотиновые паучи`
      : `${product.brand} ${strengthLabel} Nicotine Pouches`;

const flavorLabels: Record<string, string> = {
  mint: t.flavors.mint,
  citrus: t.flavors.citrus,
  berry: t.flavors.berry,
  coffee: t.flavors.coffee,
  tropical: t.flavors.tropical,
};
const verificationCopy = {
  en: { status: 'Availability is confirmed in Telegram before delivery. Numeric nicotine measurements are not shown until a source is verified.', brand: 'View represented products from this brand', shipping: 'Shipping & payment details' },
  ro: { status: 'Disponibilitatea este confirmată în Telegram înainte de livrare. Măsurătorile numerice ale nicotinei nu apar până la verificarea unei surse.', brand: 'Vezi produsele reprezentate ale acestei mărci', shipping: 'Detalii despre livrare și plată' },
  ru: { status: 'Наличие подтверждается в Telegram до доставки. Числовые показатели никотина не публикуются до проверки источника.', brand: 'Товары этого бренда в каталоге', shipping: 'Условия доставки и оплаты' },
}[lang];

const telegramLink = getTelegramOrderLink(lang, {
  name: translation.name,
  strength: product.strength,
});

// Generate product schema without pricing/offers.
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": translation.name,
  "description": translation.description,
  "url": productAbsoluteUrl,
  "category": "Nicotine Pouches",
  "brand": {
    "@type": "Brand",
    "name": product.brand,
  },
  "image": imageAbsoluteUrl,
  "audience": {
    "@type": "PeopleAudience",
    "suggestedMinAge": 18,
  },
  "additionalProperty": [
    {
      "@type": "PropertyValue",
      "name": "Flavor",
      "value": flavorLabels[product.flavorCategory],
    },
    {
      "@type": "PropertyValue",
      "name": "Pouches per Can",
      "value": product.pouchesPerCan,
    },
  ],
};

// Breadcrumb schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": t.nav.home,
      "item": homeAbsoluteUrl,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": t.nav.catalog,
      "item": catalogAbsoluteUrl,
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": translation.name,
      "item": productAbsoluteUrl,
    },
  ],
};
---

<!-- Schemas -->
<script is:inline type="application/ld+json" set:html={serializeJsonLd(productSchema)} />
<script is:inline type="application/ld+json" set:html={serializeJsonLd(breadcrumbSchema)} />

<section class="py-12 md:py-20">
  <div class="container">
    <!-- Breadcrumb -->
    <nav class="mb-8" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-caption text-muted">
        <li>
          <a href={getLocalizedPath('/', lang)} class="hover:text-primary transition-colors">
            {t.nav.home}
          </a>
        </li>
        <li>/</li>
        <li>
          <a href={catalogPath} class="hover:text-primary transition-colors">
            {t.nav.catalog}
          </a>
        </li>
        <li>/</li>
        <li class="text-primary font-medium" aria-current="page">
          {translation.name}
        </li>
      </ol>
    </nav>
    
    <div class="grid md:grid-cols-2 gap-12 lg:gap-16">
      <!-- Product Image -->
      <div class="relative">
        <div class="product-image-shell aspect-square rounded-3xl overflow-hidden">
          <img
            src={imageSrc}
            alt={translation.name}
            width={imageMetadata.width}
            height={imageMetadata.height}
            decoding="async"
            srcset={responsiveImage.srcset || undefined}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="w-full h-full object-contain p-8"
            onerror={`this.src='${placeholderSrc}'`}
          />
        </div>
        <!-- Strength Badge -->
        <span class="absolute top-6 right-6 px-4 py-2 bg-white shadow-card text-body font-semibold rounded-full">
          {strengthLabels[product.strengthCategory]}
        </span>
      </div>
      
      <!-- Product Info -->
      <div class="flex flex-col">
        <a class="text-caption text-muted mb-2 hover:text-accent" href={getLocalizedPath(`/brands/${product.brand.toLowerCase()}/`, lang)}>{product.brand}</a>
        <h1 class="text-xl md:text-3xl font-semibold mb-3">{productHeading}</h1>
        
        <p class="text-sm md:text-base text-muted mb-5">{translation.description}</p>
        <p class="text-caption text-muted mb-5">{verificationCopy.status}</p>
        
        <!-- Specs -->
        <div class="grid grid-cols-2 gap-4 mb-8">
          <div class="bg-surface rounded-xl p-4">
            <span class="text-caption text-muted block mb-1">{t.product.strength}</span>
            <span class="text-body font-medium">{strengthLabels[product.strengthCategory]}</span>
          </div>
          <div class="bg-surface rounded-xl p-4">
            <span class="text-caption text-muted block mb-1">{t.product.flavor}</span>
            <span class="text-body font-medium">{flavorLabels[product.flavorCategory]}</span>
          </div>
          <div class="bg-surface rounded-xl p-4">
            <span class="text-caption text-muted block mb-1">{t.product.brand}</span>
            <span class="text-body font-medium">{product.brand}</span>
          </div>
          <div class="bg-surface rounded-xl p-4">
            <span class="text-caption text-muted block mb-1">{t.product.pouches}</span>
            <span class="text-body font-medium">{product.pouchesPerCan}</span>
          </div>
        </div>
        <div class="flex flex-wrap gap-4 mb-7 text-small">
          <a class="text-accent hover:underline" href={getLocalizedPath(`/brands/${product.brand.toLowerCase()}/`, lang)}>{verificationCopy.brand}</a>
          <a class="text-accent hover:underline" href={getLocalizedPath('/shipping-payment/', lang)}>{verificationCopy.shipping}</a>
        </div>
        
        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-4 mt-auto">
          <Button href={telegramLink} variant="primary" size="lg" class="flex-1" external>
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
            {t.product.orderNow}
          </Button>
          <Button href={catalogPath} variant="secondary" size="lg">
            {t.product.backToCatalog}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .product-image-shell {
    background:
      radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.95) 0%, rgba(246, 247, 249, 0.9) 45%, rgba(237, 239, 243, 0.85) 100%);
    border: 1px solid rgba(15, 23, 42, 0.08);
  }
</style>
