{
  "name": "pouch-catalog",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "validate:dist": "node scripts/validate-dist.mjs",
    "audit:high": "npm audit --audit-level=high",
    "ci": "npm run check && npm run typecheck && npm test && npm run validate:content && npm run build && npm run validate:seo && npm run validate:dist && npm run audit:high"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.9",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^20.0.0",
    "autoprefixer": "^10.5.2",
    "typescript": "^5.0.0"
  }
}
